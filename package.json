{
  "name": "discord-bots",
  "version": "0.1.0",
  "private": true,
  "description": "Bots de Discord do Icaro — DJ NARUTINHO (música) e Icarus (voz), sobre uma base compartilhada",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @bots/shared && npm run build -w @bots/dj",
    "build:shared": "npm run build -w @bots/shared",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:dj": "npm run dev -w @bots/dj"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}

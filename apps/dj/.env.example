# --- Discord ---
DISCORD_TOKEN=
CLIENT_ID=
# Allowlist de guilds, separadas por vírgula. O bot sai de qualquer servidor fora desta lista.
GUILD_IDS=
# Registro global de comandos (propaga em até 1h). Vazio/false = registra por guild (instantâneo).
REGISTER_GLOBAL=false

# --- Banco ---
DATABASE_URL=postgres://discord_dj:senha@postgres:5432/appdb
DATABASE_SCHEMA=discord_dj

# --- Biblioteca ---
DRIVE_REMOTE=gdrive:discord-dj-music
MUSIC_CACHE_DIR=/app/music-cache
RCLONE_CONFIG_PATH=/home/node/.config/rclone/rclone.conf
COOKIES_FILE=/app/cookies/youtube.txt

# --- yt-dlp ---
MAX_DURATION_SEC=1200
# Ids do Discord isentos do limite acima (separados por vírgula). O teto protege
# contra encher a fila com um mix de 4h sem querer; o dono do bot não precisa dele.
SEM_LIMITE_DURACAO=
PLAYER_CLIENTS=web,mweb,tv
# Opcional: provedor de PO token, só se o cookie sozinho não bastar
POT_PROVIDER_URL=

# --- Player ---
# Tempo ocioso (ms) antes de o bot sair da call sozinho
IDLE_TIMEOUT_MS=120000
MAX_QUEUE=200
DOWNLOAD_COOLDOWN_MS=5000

# --- Sync das playlists do YouTube Music (sync-playlists.js, via cron) ---
# Cookie (Netscape) da conta pessoal, usado só para LISTAR as playlists. Os downloads
# usam o COOKIES_FILE acima, da conta dedicada.
YTMUSIC_COOKIES_FILE=/app/ytmusic/cookies.txt
# Faixas novas baixadas por rodada — o acervo completo chega em várias rodadas
SYNC_MAX_POR_EXECUCAO=60
# Ids de playlist a ignorar, separados por vírgula (WL, LL e mixes RD já são ignorados)
SYNC_IGNORAR_PLAYLISTS=

# --- Discord ---
DISCORD_TOKEN=
CLIENT_ID=
GUILD_IDS=
REGISTER_GLOBAL=false

# --- Banco ---
DATABASE_URL=postgres://icarus:senha@postgres:5432/appdb
DATABASE_SCHEMA=icarus

# --- Biblioteca de música (própria, separada do DJ) ---
DRIVE_REMOTE=gdrive:icarus-music
MUSIC_CACHE_DIR=/app/music-cache
RCLONE_CONFIG_PATH=/home/node/.config/rclone/rclone.conf
COOKIES_FILE=/app/cookies/youtube.txt

# --- yt-dlp ---
MAX_DURATION_SEC=1200
PLAYER_CLIENTS=web,mweb,tv
POT_PROVIDER_URL=http://bgutil-provider:4416

# --- Player ---
IDLE_TIMEOUT_MS=120000
MAX_QUEUE=200
DOWNLOAD_COOLDOWN_MS=5000

# --- Voz ---
WAKE_WORD=cubo
WAKE_BUFFER_MS=3000
# Janela do MODO CONVERSA (depois de ele já estar falando com alguém). Generosa de
# propósito: com 10s, quem demorava 11s para responder tinha a resposta do bot gerada
# e descartada. Antes de ser chamado ele não responde de qualquer forma, então o custo
# de uma janela longa aqui é baixo.
SESSAO_SILENCIO_MS=35000
# duas falas seguidas sem ele responder = a conversa seguiu sem ele, fecha na hora
MAX_TURNOS_SEM_RESPOSTA=2

# --- Gemini Live ---
GEMINI_API_KEY=
# preview: pode mudar ou sumir sem aviso
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_VOICE=Puck
GEMINI_LANGUAGE=pt-BR

# --- Ducking (vazio desliga) ---
DJ_DUCKING_URL=http://discord-dj:8099/ducking
DUCKING_VOLUME=0.25

# --- Memória (vazio desliga a transcrição de ambiente) ---
WHISPER_BIN=/usr/local/bin/whisper-cli
WHISPER_MODEL_WAKE=/opt/modelos/ggml-base.bin
# base de propósito: roda a 0,23x o tempo real e acompanha vários falantes, enquanto
# small (0,95x) fica para trás e a fila começa a descartar. Decisão do Icaro: memória
# COMPLETA e imprecisa vale mais que precisa e cheia de buracos — dá para limpar o
# texto depois, mas não dá para recuperar o que nunca foi gravado.
WHISPER_MODEL_MEMORIA=/opt/modelos/ggml-base.bin
WHISPER_THREADS=2
TRANSCRICAO_CONCORRENCIA=3
TAMANHO_TRECHO=150

# --- Persona e conhecimento (opcionais) ---
PERSONA_FILE=
CONHECIMENTO_FILE=/app/conhecimento/bayuka.md

# --- Painel de diagnóstico (0 desliga) ---
PAINEL_PORT=8790
